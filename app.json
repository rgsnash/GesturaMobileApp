{
  "expo": {
    "name": "Gestura-MobileApp",
    "slug": "Gestura-MobileApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gestura",
    "extra": {
      "SUPABASE_URL": "https://qutjxqklxkovjncqtmbv.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF1dGp4cWtseGtvdmpuY3F0bWJ2Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTczODI0MTk2MiwiZXhwIjoyMDUzODE3OTYyfQ.glRiXJhP9m5dLYRpfqyg9hmm4vSAqdP-dVX4je1ELME",
      "redirectUri": {
        "development": "https://auth.expo.io/@ashleymuiu/Gestura-MobileApp",
        "production": "gestura://oauth-redirect"
      }
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "gestura"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gestura",
              "host": "oauth-redirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "poetic-lobster-5.clerk.accounts.dev",
              "pathPrefix": "/oauth-redirect/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.ashleymuiu.GesturaMobileApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "cover",
          "backgroundColor": "#D9D9D9",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Oswald-Bold.ttf",
            "./assets/fonts/Oswald-SemiBold.ttf",
            "./assets/fonts/Oswald-Light.ttf",
            "./assets/fonts/Oswald-ExtraLight.ttf",
            "./assets/fonts/Oswald-Regular.ttf",
            "./assets/fonts/Oswald-Medium.ttf",
            "./assets/fonts/Montserrat-ExtraBold.ttf"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
